[Unit]
Description=EmuELEC-H3 CONTROLLER
After=multi-user.target

[Service]
Type=idle
# Python 2 controller (/usr/bin/python is 3.7 here); prefer the user's copy in /storage
ExecStart=/bin/sh -c 'f=/storage/.config/gpio/tz_gpio_controller.py; [ -f "$f" ] || f=/usr/config/gpio/tz_gpio_controller.py; exec /usr/bin/python2 "$f"'

[Install]
WantedBy=multi-user.target
