+#pragma once
+#ifndef ES_APP_SCRAPERS_STEAMGRIDDB_SCRAPER_H
+#define ES_APP_SCRAPERS_STEAMGRIDDB_SCRAPER_H
+
+#include "scrapers/Scraper.h"
+
+// SteamGridDB (https://www.steamgriddb.com) only has artwork: box art (grids),
+// banners (heroes) and transparent logos. It needs a free API key, stored in
+// the "SteamGridDBKey" setting.
+class SteamGridDBScraper : public Scraper
+{
+public:
+	void generateRequests(const ScraperSearchParams& params,
+		std::queue<std::unique_ptr<ScraperRequest>>& requests,
+		std::vector<ScraperSearchResult>& results) override;
+
+	bool isSupportedPlatform(SystemData* system) override;
+
+	const std::set<ScraperMediaSource>& getSupportedMedias() override;
+};
+
+// One step of a lookup. The search step queues the artwork steps and a final
+// commit, which share one partial result: the search handle stops at the first
+// finished request that left a result behind, so only the commit may add it.
+class SteamGridDBRequest : public ScraperHttpRequest
+{
+public:
+	enum Step { SEARCH, GRID, HERO, LOGO };
+
+	SteamGridDBRequest(std::queue<std::unique_ptr<ScraperRequest>>* requestsWrite,
+		std::vector<ScraperSearchResult>& resultsWrite, const std::string& url, Step step,
+		std::shared_ptr<ScraperSearchResult> partial);
+
+protected:
+	bool process(HttpReq* request, std::vector<ScraperSearchResult>& results) override;
+
+private:
+	static HttpReqOptions* authOptions();
+
+	std::queue<std::unique_ptr<ScraperRequest>>* mRequestQueue;
+	Step mStep;
+	std::shared_ptr<ScraperSearchResult> mPartial;
+};
+
+class SteamGridDBCommit : public ScraperRequest
+{
+public:
+	SteamGridDBCommit(std::vector<ScraperSearchResult>& resultsWrite, std::shared_ptr<ScraperSearchResult> partial)
+		: ScraperRequest(resultsWrite), mPartial(partial) { }
+
+	void update() override;
+
+private:
+	std::shared_ptr<ScraperSearchResult> mPartial;
+};
+
+#endif // ES_APP_SCRAPERS_STEAMGRIDDB_SCRAPER_H
