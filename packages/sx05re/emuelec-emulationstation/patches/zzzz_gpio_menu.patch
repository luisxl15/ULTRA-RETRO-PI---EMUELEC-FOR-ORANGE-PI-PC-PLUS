+#ifdef _ENABLEEMUELEC
+	// Ultra Retro Pi: GPIO controls (python controller from the gpio package), only where it ships.
+	// Same ee_gpio.enabled that emuelec_autostart.sh reads at boot.
+	if (Utils::FileSystem::exists("/usr/lib/systemd/system/gpio.service"))
+	{
+		auto gpio_enabled = std::make_shared<SwitchComponent>(window);
+		gpio_enabled->setState(SystemConf::getInstance()->get("ee_gpio.enabled") == "1");
+		s->addWithLabel(_("GPIO CONTROLS"), gpio_enabled);
+		s->addSaveFunc([gpio_enabled]
+		{
+			bool on = gpio_enabled->getState();
+			if (on != (SystemConf::getInstance()->get("ee_gpio.enabled") == "1"))
+			{
+				SystemConf::getInstance()->set("ee_gpio.enabled", on ? "1" : "0");
+				SystemConf::getInstance()->saveSystemConf();
+				runSystemCommand(on ? "systemctl start gpio" : "systemctl stop gpio", "", nullptr);
+			}
+		});
+	}
+#endif
